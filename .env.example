# Copy to .env and fill in:  cp .env.example .env
# Generate secrets with:      openssl rand -base64 48 | tr -d '\n=/+' | cut -c1-50

# --- Required ---
SECRET_KEY=change-me-to-a-long-random-string
DB_PASSWORD=change-me-too

# Where people reach the app.
#   Testing on the LAN:   SITE_ADDRESS=:80   ALLOWED_HOSTS=<vm-ip>   SITE_URL=http://<vm-ip>   HTTPS=False
#   Production:           SITE_ADDRESS=risk.example.com   ALLOWED_HOSTS=risk.example.com
#                         SITE_URL=https://risk.example.com   CSRF_TRUSTED_ORIGINS=https://risk.example.com   HTTPS=True
SITE_ADDRESS=:80
#   HTTPS on a bare IP (no domain yet), browser shows a one-time certificate warning:
#     SITE_ADDRESS="https://<public-ip>, https://<lan-ip>"   TLS_MODE=internal   DEFAULT_SNI=<public-ip>
TLS_MODE=auto
DEFAULT_SNI=localhost
# Who may connect (space-separated IPs or ranges). Default: everyone.
ALLOWED_IPS="0.0.0.0/0 ::/0"
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost
CSRF_TRUSTED_ORIGINS=
HTTPS=False

# --- Optional ---
APP_NAME=Risk Register
TIME_ZONE=Asia/Nicosia
REQUIRE_TWO_STEP=True
SESSION_IDLE_MINUTES=30
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
DEBUG=False

# Email for task assignment notices. Leave EMAIL_BACKEND as console to just log them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=risk@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=risk@example.com
